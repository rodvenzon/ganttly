{
  "name": "ganttly",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "db:seed": "node scripts/prepare-env.mjs && node --env-file=.env --import tsx seed.ts",
    "db:seed:large": "node scripts/prepare-env.mjs && node --env-file=.env --import tsx scripts/seed-large.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "node --env-file=.env --import tsx scripts/smoke-api.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pages:build": "node scripts/build-pages.mjs",
    "pages:dev": "node scripts/build-pages.mjs && wrangler pages dev out --d1 DB=ganttly-db --port 8788"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libsql/client": "^0.15.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.0",
    "date-fns": "^4.1.0",
    "exceljs": "4.4.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.0",
    "postcss": "^8.5.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.148.0"
  }
}
